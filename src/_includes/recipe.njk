---
layout: base.njk
pageScript: recipe.js
---
<article data-recipe-id="{{ id }}" data-base-servings="{{ servings }}">
  <div class="recipe-hero">
    <div class="recipe-hero__panel"></div>
    <a href="/" class="back-button back-button--floating" aria-label="Back to recipes"><i class="fa-solid fa-arrow-left"></i></a>
    {% if image %}
    <div class="recipe-hero__image-wrap">
      <img src="{{ image }}" alt="{{ title }}" class="recipe-hero__image">
    </div>
    {% endif %}
  </div>

  <div class="recipe-drawer">
    <header>
      <div class="recipe-header__top">
        <h1>{{ title }}</h1>
        <div class="recipe-header__actions">
          <button id="wake-lock-toggle" class="icon-button" aria-label="Keep screen on" aria-pressed="false">
            <i class="fa-regular fa-sun"></i>
          </button>
          <button id="add-to-planner" class="icon-button" data-id="{{ id }}" aria-label="Add to planner" aria-pressed="false">
            <i class="fa-solid fa-calendar-plus"></i>
          </button>
        </div>
      </div>

      <span class="difficulty">{{ difficulty }}</span>

      <div class="servings-control">
        <label>Servings</label>
        <button id="servings-down" aria-label="Decrease servings">−</button>
        <output id="servings">{{ servings }}</output>
        <button id="servings-up" aria-label="Increase servings">+</button>
      </div>
    </header>

    <section id="ingredients-section">
      <h2>Ingredients</h2>
      <div id="ingredients-all"></div>
    </section>

    <section id="steps-section">
      <h2>Steps</h2>
      {{ content | safe }}
    </section>
  </div>
</article>
