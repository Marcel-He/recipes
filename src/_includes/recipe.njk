---
layout: base.njk
pageScript: recipe.js
---
<article data-recipe-id="{{ id }}" data-base-servings="{{ servings }}">
  <div class="recipe-hero">
    <div class="recipe-hero__panel"></div>
    <a href="/" class="back-button back-button--floating" aria-label="Back to recipes"><i class="fa-solid fa-arrow-left"></i></a>
    {% if image %}
    <div class="recipe-hero__image-wrap">
      <img src="{{ image }}" alt="{{ title }}" class="recipe-hero__image">
    </div>
    {% endif %}
  </div>

  <div class="recipe-drawer">
    <header>
      <h1>{{ title }}</h1>
      <span class="difficulty">{{ difficulty }}</span>

      <div class="servings-control">
        <label>Servings</label>
        <button id="servings-down">−</button>
        <output id="servings">{{ servings }}</output>
        <button id="servings-up">+</button>
      </div>

      <button id="wake-lock-toggle">Keep screen on</button>
      <button id="add-to-planner" data-id="{{ id }}">+ Planner</button>
    </header>

    <section id="ingredients-section">
      <h2>Ingredients</h2>
      <div id="ingredients-all"></div>
    </section>

    <section id="steps-section">
      <h2>Steps</h2>
      {{ content | safe }}
    </section>
  </div>
</article>
